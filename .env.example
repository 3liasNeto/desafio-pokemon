# =============================================================================
# Desafio Pokémon — variáveis de ambiente
#
# Copie para .env (local) ou cadastre em "Variables" no Railway.
# São lidas no BUILD (npm run build): ao mudar uma variável no Railway, ele faz
# um novo deploy automaticamente e o site já sai com o valor novo.
# Todas são opcionais: sem elas o jogo funciona, só sem os extras indicados.
# =============================================================================

# --- Site -------------------------------------------------------------------

# URL pública do site, sem barra no final.
# Usada nos links de "compartilhar desafio" e "compartilhar run", na URL canônica,
# no sitemap.xml e na imagem de prévia dos links (Open Graph).
# Sem ela, os links usam o endereço que estiver aberto no navegador e o sitemap não é gerado.
VITE_PUBLIC_URL=https://desafio-pokemon.up.railway.app

# Subpasta onde o site é servido. Use "/" quando o site está na raiz do domínio
# (o caso normal no Railway). Ex.: "/desafio/" para https://seusite.com/desafio/
VITE_BASE_PATH=/

# --- Rodapé ------------------------------------------------------------------

# Seu nome (aparece como "Feito por ..." e como autor nos dados para buscadores).
VITE_AUTHOR_NAME=Seu Nome

# Link do seu portfólio (botão no rodapé). Deixe vazio para esconder.
VITE_PORTFOLIO_URL=https://seu-portfolio.com

# Doação por Pix. Só a chave já mostra o botão "Apoie com Pix" com a chave para copiar.
# Com nome e cidade também, o rodapé gera o QR Code e o "Pix copia e cola" (BR Code),
# que qualquer app de banco lê. Nome: até 25 letras; cidade: até 15 (sem acentos é o ideal).
VITE_PIX_KEY=sua-chave-pix@email.com
VITE_PIX_NAME=Seu Nome
VITE_PIX_CITY=Sao Paulo

# --- Imagens (avançado) ------------------------------------------------------
# Só mude se for hospedar as imagens por conta própria (mesma estrutura de pastas).

# Sprites de Pokémon e treinadores e cenários de batalha (padrão: Pokémon Showdown).
VITE_SPRITES_URL=https://play.pokemonshowdown.com

# Ícones dos itens em PNG (padrão: repositório de sprites da PokeAPI).
VITE_ITEM_ICONS_URL=https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items
